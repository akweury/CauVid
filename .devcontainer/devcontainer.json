{
	"name": "cauvid",
	"build": {
		"dockerfile": "../.docker/Dockerfile",
		"context": ".."
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"github.copilot",
				"ms-python.isort",
				"ms-python.black-formatter",
				"ms-toolsai.jupyter"
			]
		},
		"settings": {
			"terminal.integrated.defaultProfile.linux": "zsh"
		}
	},
	"runArgs": [
		"--gpus",
		"all",
		"--shm-size=20g",
		"--cpus",
		"100"
	]
}